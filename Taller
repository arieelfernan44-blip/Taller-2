function deleteSelectedMoves(){const ids=[...selectedMoveIds].filter(id=>db.moves.some(m=>m.id===id));if(!ids.length)return alert('Seleccioná al menos un movimiento.');if(!confirm(`¿Eliminar ${ids.length} movimiento(s) del historial? Esto no modifica el inventario, las fabricaciones ni los gastos.`))return;const ok=transact(()=>{const remove=new Set(ids);db.moves=db.moves.filter(m=>!remove.has(m.id))},'Movimientos eliminados.');if(ok){selectedMoveIds.clear();renderMovements()}}
function clearAllMoves(){if(!db.moves.length)return notify('El historial ya está vacío.');if(!confirm(`¿Borrar los ${db.moves.length} movimientos del historial? Esta acción solo elimina el registro visual; no modifica stock, fabricaciones ni sobrantes.`))return;const ok=transact(()=>{db.moves=[]},'Historial de movimientos borrado.');if(ok){selectedMoveIds.clear();renderMovements()}}
