function backup(){const payload={app:'Gestion del Taller',schema:1,exportedAt:new Date().toISOString(),data:db};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`respaldo-taller-${localDate()}.json`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);notify('Copia de seguridad descargada.')}
function importDb(data){const x=data?.data&&typeof data.data==='object'?data.data:data;if(!x||!Array.isArray(x.materials)||!Array.isArray(x.leftovers)||!Array.isArray(x.jobs)||!Array.isArray(x.models)||!Array.isArray(x.expenses)||!Array.isArray(x.moves))throw new Error('Estructura inválida');return migrateOld(x)}
function restoreFile(file){const reader=new FileReader();reader.onload=()=>{try{const imported=importDb(JSON.parse(reader.result));if(!confirm('La restauración reemplazará los datos actuales de este navegador. Antes de continuar, descargá una copia actual por seguridad. ¿Continuar?'))return;const before=db;db=imported;selectedJobIds.clear();selectedMoveIds.clear();try{localStorage.setItem(APP_KEY,JSON.stringify(db));renderAll();notify('Copia restaurada correctamente.')}catch(e){db=before;renderAll();throw e}}catch(e){alert('No se pudo restaurar: el archivo no es una copia válida o no hay espacio para guardarlo.')}finally{$('restoreFile').value=''}};reader.readAsText(file)}
function exportCsv(){const rows=[['Fecha','Tipo','Detalle'],...db.moves.map(m=>[m.date,m.type,m.detail])];const csv='\ufeff'+rows.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n');const blob=new Blob([csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`movimientos-taller-${localDate()}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);notify('Historial CSV exportado.')}
