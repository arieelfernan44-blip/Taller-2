.scrap-search-tools{display:grid;grid-template-columns:minmax(145px,1fr) minmax(145px,1fr) auto;align-items:end;gap:8px;min-width:min(560px,60%)}.scrap-search-tools .field{min-width:0;margin:0}.search-meta{font-size:11px;color:var(--muted);margin:-3px 0 8px}.group-material .scrap-item-main{min-width:0;flex:1}.group-material .scrap-item-main strong{display:block}.group-material .scrap-item-main .secondary-cell{overflow-wrap:anywhere}.group-material .scrap-view-btn{flex:0 0 auto}.inventory-action-note{font-size:10px;color:var(--muted);margin-top:4px;max-width:190px}@media(max-width:1100px){.layout{grid-template-columns:200px minmax(0,1fr);gap:15px;padding:16px}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.field-grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.scrap-search-tools{width:100%;min-width:0;grid-template-columns:repeat(2,minmax(0,1fr)) auto}.scrap-list-head{align-items:stretch;flex-direction:column}.group-material{align-items:flex-start}.group-material .scrap-view-btn{white-space:normal}.app-header{height:auto;min-height:66px;padding:10px 13px}.brandmark{width:36px;height:36px}.brand-title{font-size:15px}.brand-sub{font-size:10px}.save-status{display:none}.header-actions .btn{padding:8px;font-size:10px}.layout{display:block;padding:12px}.sidebar{position:sticky;top:66px;z-index:15;margin-bottom:14px;padding:6px;border-radius:12px}.nav-label,.sidebar-note{display:none}.nav-list{display:flex;overflow:auto;gap:4px}.nav-btn{width:auto;flex:0 0 auto;padding:9px 11px;font-size:11px;margin:0}.nav-icon{display:none}.page-head h1{font-size:22px}.content-grid{grid-template-columns:1fr}.panel{padding:14px}.field-grid{grid-template-columns:1fr}.field-grid.three{grid-template-columns:1fr}.page-head{align-items:flex-start;flex-direction:column}}
@media(max-width:420px){.scrap-search-tools{grid-template-columns:1fr 1fr}.scrap-search-tools #clearScrapSearchBtn{grid-column:1/-1}.cards{gap:8px}.metric-card{padding:13px}.metric-value{font-size:24px}.metric-top{font-size:10px}.metric-icon{width:27px;height:27px}.header-actions{gap:5px}.header-actions .btn{font-size:0;gap:0}.header-actions .btn .btn-text{font-size:10px}.panel-head{align-items:flex-start;flex-direction:column}}

.detail-toggle{border:0;background:transparent;color:var(--blue);font-size:10px;font-weight:800;padding:5px 0 0;cursor:pointer;text-align:left}.detail-toggle:hover{text-decoration:underline}.material-detail{margin-top:7px;padding:8px 10px;background:#f5f8fc;border:1px solid #e5edf5;border-radius:8px;color:#50657c;font-size:11px;line-height:1.5}.material-detail[hidden]{display:none!important}.selection-cell{width:34px;text-align:center}.selection-cell input{width:16px;min-height:16px;padding:0;accent-color:var(--blue)}.row-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.job-card{border:1px solid var(--line);border-radius:12px;padding:13px;margin:10px 0;background:#fff}.job-card.selected{border-color:#8eb2e5;background:#f7faff}.job-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.job-select{width:17px;min-height:17px;accent-color:var(--blue)}.job-title-wrap{display:flex;align-items:flex-start;gap:9px;min-width:0}.selection-count{font-size:10px;color:var(--muted);font-weight:700;align-self:center}

.archived-inventory-panel{border-style:dashed;background:#fcfdff}.archived-inventory-panel .badge.neutral{margin-top:5px}.inventory-action-note{font-size:10px;color:var(--muted);margin-top:6px;max-width:260px;line-height:1.4}.row-actions .btn{min-height:30px}.archived-inventory-panel .table-wrap{margin-top:4px}
