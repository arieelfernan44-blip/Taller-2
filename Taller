      <div class="content-grid"><div class="panel"><div class="panel-head"><div><h2>Guardar modelo</h2><div class="panel-desc">Ficha de producto con dimensiones propias.</div></div></div><div class="field"><label for="modelName">Nombre del modelo *</label><input id="modelName" placeholder="Ej. Puerta de dos hojas"></div><div class="field-grid"><div class="field"><label for="modelType">Tipo de producto</label><input id="modelType" placeholder="Puerta"></div><div class="field"><label for="modelLine">Línea / serie</label><input id="modelLine" placeholder="Opcional"></div></div>
        <div class="stock-box"><div class="stock-box-title">Medidas del producto (cm) — no son stock</div><div class="field-grid"><div class="field"><label for="modelWidth">Ancho (cm)</label><input id="modelWidth" inputmode="decimal" placeholder="Ej. 90"></div><div class="field"><label for="modelHeight">Alto (cm)</label><input id="modelHeight" inputmode="decimal" placeholder="Ej. 210"></div></div></div><div class="field"><label for="modelNotes">Notas</label><textarea id="modelNotes" placeholder="Características del modelo..."></textarea></div><button class="btn btn-primary" id="saveModelBtn">Guardar modelo</button></div>
      <div class="panel"><div class="panel-head"><div><h2>Modelos guardados</h2><div class="panel-desc">Podés cargar un modelo directamente al formulario de fabricación.</div></div></div><div id="modelRows"></div></div></div>
    </section>

    <section class="page" id="page-movements"><div class="page-head"><div><div class="eyebrow">Trazabilidad</div><h1>Movimientos</h1><p>Registro de entradas, ajustes, consumos, sobrantes y anulaciones.</p></div><button class="btn btn-ghost" id="exportCsvBtn">⇩ Exportar CSV</button></div><div class="panel"><div class="panel-head"><div><h2>Administrar historial de movimientos</h2><div class="panel-desc">Borrar movimientos elimina solo las líneas del historial; no cambia el stock ni las fabricaciones.</div></div><div class="row-actions"><button class="btn btn-ghost btn-sm" id="selectAllMovesBtn">Seleccionar todo</button><button class="btn btn-danger btn-sm" id="deleteSelectedMovesBtn" disabled>Eliminar seleccionados</button><button class="btn btn-danger btn-sm" id="clearAllMovesBtn">Borrar todo el historial</button></div></div><div class="table-wrap"><table><thead><tr><th><input type="checkbox" id="selectAllMovesCheck" aria-label="Seleccionar todos los movimientos"></th><th>Fecha</th><th>Tipo</th><th>Detalle</th></tr></thead><tbody id="movementRows"></tbody></table></div></div></section>
    <div class="footer-note">Gestión del Taller · Los datos quedan guardados localmente en este dispositivo.</div>
  </main>
</div>
<div class="modal-backdrop" id="modalBackdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal"><h2 id="modalTitle">Detalle</h2><div class="modal-body" id="modalBody"></div><div class="modal-foot"><button class="btn btn-ghost" id="modalClose">Cerrar</button><button class="btn btn-primary hidden" id="modalConfirm">Confirmar</button></div></div></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
'use strict';
const APP_KEY='gestion_taller_final_v1';
const LEGACY_KEY='gestionTaller_v3';
const $=id=>document.getElementById(id);
const uid=()=>globalThis.crypto?.randomUUID?.()||('id-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,10));
const deepCopy=x=>JSON.parse(JSON.stringify(x));
const number=v=>{if(typeof v==='number')return v;let s=String(v??'').trim().replace(/\s/g,'');if(s==='')return NaN;if(s.includes(',')&&s.includes('.'))s=s.replace(/\./g,'').replace(',','.');else if(s.includes(','))s=s.replace(',','.');else if(/^[-+]?\d{1,3}(\.\d{3})+$/.test(s))s=s.replace(/\./g,'');return Number(s)};
const clean=v=>String(v??'').trim();
const norm=v=>clean(v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\s+/g,' ');
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=(v,max=3)=>new Intl.NumberFormat('es-AR',{maximumFractionDigits:max}).format(Number(v)||0);
const money=v=>new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:2}).format(Number(v)||0);
const localDate=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
const dateTime=()=>new Date().toLocaleString('es-AR');
const DISCRETE_UNITS=new Set(['barras','unidades','piezas','paquetes','rollos']);
function blankDb(){return {schema:1,materials:[],leftovers:[],jobs:[],models:[],expenses:[],moves:[]}}
function migrateOld(x){
  const out=blankDb();
  out.materials=(Array.isArray(x.materials)?x.materials:[]).map(m=>({id:String(m.id||uid()),name:clean(m.name)||'Material sin nombre',category:clean(m.category??m.cat)||'Sin categoría',unit:clean(m.unit)||'unidades',detail:clean(m.detail??m.spec),stock:Math.max(0,Number(m.stock??m.qty)||0),minStock:Math.max(0,Number(m.minStock??m.min)||0),archived:!!m.archived,deleted:!!m.deleted,deletedAt:m.deletedAt||null}));
  out.leftovers=(Array.isArray(x.leftovers)?x.leftovers:[]).map(l=>({id:String(l.id||uid()),materialId:String(l.materialId||''),materialName:clean(l.materialName??l.name)||'Material',unit:clean(l.unit)||'unidades',category:clean(l.category)||'Sin categoría',description:clean(l.description??l.measure),initialQty:Math.max(0,Number(l.initialQty??l.qty)||0),remainingQty:Math.max(0,Number(l.remainingQty??l.qty)||0),status:(l.status==='inactive'||l.active===false)?'inactive':'active',origin:clean(l.origin)||'Registro anterior',jobId:l.jobId||null,deleted:!!l.deleted,deletedAt:l.deletedAt||null}));
  out.jobs=(Array.isArray(x.jobs)?x.jobs:[]).map(j=>{const units=Math.max(1,Number(j.units)||1);const oldLines=Array.isArray(j.lines)?j.lines:(Array.isArray(j.consumes)?j.consumes:[]);const lines=oldLines.map(c=>{const src=c.source==='leftover'?'leftover':'material';const total=Number(c.totalQty??c.qty)||0;return {source:src,itemId:String(c.itemId??(src==='leftover'?c.leftoverId:c.materialId)??''),itemName:clean(c.itemName??c.name)||'Material',qtyPerUnit:Number(c.qtyPerUnit)||total/units,totalQty:total,unit:clean(c.unit)||(src==='leftover'?'piezas':'unidades')}});return {id:String(j.id||uid()),date:clean(j.date)||localDate(),product:clean(j.product)||'Producto',units,width:clean(j.width),height:clean(j.height),modelId:j.modelId||'',notes:clean(j.notes),lines,leftoverIds:Array.isArray(j.leftoverIds)?j.leftoverIds.map(String):[],status:j.status==='Anulada'?'cancelled':j.status==='cancelled'?'cancelled':'active'};});
  out.models=(Array.isArray(x.models)?x.models:[]).map(m=>({id:String(m.id||uid()),name:clean(m.name)||'Modelo',type:clean(m.type),line:clean(m.line),width:clean(m.width),height:clean(m.height),notes:clean(m.notes)}));
  out.expenses=(Array.isArray(x.expenses)?x.expenses:[]).map(e=>({id:String(e.id||uid()),date:clean(e.date)||localDate(),concept:clean(e.concept)||'Gasto',amount:Math.max(0,Number(e.amount)||0),note:clean(e.note),active:e.active!==false}));
  out.moves=(Array.isArray(x.moves)?x.moves:[]).map(m=>({id:String(m.id||uid()),date:clean(m.date)||dateTime(),type:clean(m.type)||'Movimiento',detail:clean(m.detail)}));
  return out;
}
function readDb(){try{const raw=localStorage.getItem(APP_KEY);if(raw){const x=JSON.parse(raw);return migrateOld(x)}}catch(e){console.warn('No se pudo leer la base local',e)}try{const old=localStorage.getItem(LEGACY_KEY);if(old){const migrated=migrateOld(JSON.parse(old));localStorage.setItem(APP_KEY,JSON.stringify(migrated));return migrated}}catch(e){console.warn('No se pudo migrar la versión anterior',e)}return blankDb()}
let db=readDb();
const selectedJobIds=new Set();
const selectedMoveIds=new Set();
let toastTimer=null;
function notify(message){const t=$('toast');t.textContent=message;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2800)}
function logMove(type,detail){db.moves.unshift({id:uid(),date:dateTime(),type,detail})}
function transact(work,message){const before=deepCopy(db);try{work();localStorage.setItem(APP_KEY,JSON.stringify(db));renderAll();if(message)notify(message);return true}catch(err){db=before;renderAll();console.error(err);alert(err?.name==='QuotaExceededError'?'No hay espacio disponible para guardar. Exportá una copia de seguridad y liberá espacio del navegador.':'No se pudo guardar el cambio. No se modificaron los datos guardados.');return false}}
function page(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+id));document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));if(id==='production')refreshProductionOptions()}
function setOptions(selectId,options,placeholder){const s=$(selectId);if(!s)return;const previous=s.value;s.innerHTML=`<option value="">${esc(placeholder)}</option>`+options.map(o=>`<option value="${esc(o.value)}">${esc(o.label)}</option>`).join('');if(options.some(o=>o.value===previous))s.value=previous}
function activeMaterials(){return db.materials.filter(m=>!m.archived&&!m.deleted)}
function activeLeftovers(){return db.leftovers.filter(l=>!l.deleted&&l.status==='active'&&l.remainingQty>0)}
function canonicalCategory(value){const wanted=clean(value);const existing=db.leftovers.find(l=>norm(l.category)===norm(wanted));return existing?existing.category:wanted}
function refreshProductionOptions(){setOptions('stockMaterial',activeMaterials().map(m=>({value:m.id,label:`${m.name} · Stock: ${fmt(m.stock)} ${m.unit}`})),'Seleccionar material');setOptions('scrapMaterial',activeMaterials().map(m=>({value:m.id,label:`${m.name} · ${m.unit}`})),'Seleccionar material');setOptions('jobModel',db.models.map(m=>({value:m.id,label:m.name})),'Sin modelo');document.querySelectorAll('.consume-source-material').forEach(s=>fillSelect(s,activeMaterials().map(m=>({value:m.id,label:`${m.name} · Stock: ${fmt(m.stock)} ${m.unit}`})),'Seleccionar material'));document.querySelectorAll('.consume-source-leftover').forEach(s=>fillSelect(s,activeLeftovers().map(l=>({value:l.id,label:`${l.category} · ${l.materialName} · ${l.description} (${l.remainingQty} pzas.)`})),'Seleccionar sobrante'));document.querySelectorAll('.generated-material').forEach(s=>fillSelect(s,activeMaterials().map(m=>({value:m.id,label:m.name})),'Material de origen'));refreshScrapCategories();updateConsumePreviews()}
function fillSelect(s,options,placeholder){const p=s.value;s.innerHTML=`<option value="">${esc(placeholder)}</option>`+options.map(o=>`<option value="${esc(o.value)}">${esc(o.label)}</option>`).join('');if(options.some(o=>o.value===p))s.value=p}
function refreshScrapCategories(){const byKey=new Map();db.leftovers.filter(l=>!l.deleted).forEach(l=>{if(clean(l.category)&&!byKey.has(norm(l.category)))byKey.set(norm(l.category),clean(l.category))});const cats=[...byKey.values()].sort((a,b)=>a.localeCompare(b,'es'));$('scrapCategories').innerHTML=cats.map(c=>`<option value="${esc(c)}"></option>`).join('')}
function addMaterial(){const name=clean($('matName').value),category=clean($('matCategory').value),unit=$('matUnit').value,detail=clean($('matDetail').value),stock=number($('matStock').value),min=number($('matMin').value||'0');if(!name||!category||!Number.isFinite(stock)||stock<0||!Number.isFinite(min)||min<0)return alert('Completá nombre, categoría y cantidades válidas. Stock y mínimo no pueden ser negativos.');if(DISCRETE_UNITS.has(unit)&&(!Number.isInteger(stock)||!Number.isInteger(min)))return alert(`La unidad ${unit} requiere cantidades enteras.`);if(activeMaterials().some(m=>norm(m.name)===norm(name)&&norm(m.category)===norm(category)&&norm(m.unit)===norm(unit)&&norm(m.detail)===norm(detail)))return alert('Ese material ya está registrado con la misma categoría, unidad y descripción. Usá una entrada para aumentar el stock.');const ok=transact(()=>{const m={id:uid(),name,category,unit,detail,stock,minStock:min,archived:false};db.materials.push(m);logMove('Alta de material',`${name}: stock inicial ${fmt(stock)} ${unit}`)},'Material registrado.');if(ok)['matName','matCategory','matDetail','matStock'].forEach(id=>$(id).value='');if(ok)refreshProductionOptions()}
function stockChange(){const m=db.materials.find(x=>x.id===$('stockMaterial').value&&!x.archived),qty=number($('stockAmount').value),action=$('stockAction').value,note=clean($('stockNote').value);if(!m||!Number.isFinite(qty)||qty<0||(action==='add'&&qty===0))return alert('Seleccioná un material e ingresá una cantidad válida.');if(DISCRETE_UNITS.has(m.unit)&&!Number.isInteger(qty))return alert(`La unidad ${m.unit} requiere cantidades enteras.`);if(action==='set'&&db.jobs.some(j=>j.status==='active'&&(j.lines||[]).some(line=>line.source==='material'&&line.itemId===m.id)))return alert('No se puede establecer el stock real mientras haya fabricaciones activas que consumieron este material. Anulá esas órdenes primero; así se evita que una anulación posterior devuelva cantidades duplicadas.');const before=m.stock,after=action==='add'?before+qty:qty;if(!Number.isFinite(after)||after<0)return alert('La operación produciría un stock inválido.');const ok=transact(()=>{m.stock=Number(after.toFixed(6));logMove(action==='add'?'Entrada de stock':'Ajuste de stock',`${m.name}: ${fmt(before)} → ${fmt(m.stock)} ${m.unit}${note?' · '+note:''}`)},'Stock actualizado.');if(ok){$('stockAmount').value='';$('stockNote').value='';refreshProductionOptions()}}
function editMaterial(id){
  const m=db.materials.find(x=>x.id===id&&!x.archived);if(!m)return;
  const activeRefs=db.jobs.some(j=>j.status==='active'&&(j.lines||[]).some(line=>line.source==='material'&&line.itemId===id));
  const unitOptions=[['piezas','Piezas'],['barras','Barras'],['unidades','Unidades'],['metros','Metros'],['m²','m²'],['kg','Kilogramos'],['litros','Litros'],['paquetes','Paquetes'],['rollos','Rollos']];
  if(!unitOptions.some(([value])=>value===m.unit))unitOptions.unshift([m.unit,m.unit]);
  const options=unitOptions.map(([value,label])=>`<option value="${value}" ${m.unit===value?'selected':''}>${label}</option>`).join('');
  showModal('Editar material',`<div class="field"><label for="editMatName">Nombre del material</label><input id="editMatName" value="${esc(m.name)}"></div><div class="field"><label for="editMatCategory">Categoría</label><input id="editMatCategory" value="${esc(m.category)}"></div><div class="field"><label for="editMatDetail">Medida / descripción técnica</label><input id="editMatDetail" value="${esc(m.detail)}" placeholder="Ej. 50 × 15 mm · largo 5 m"><div class="help">Esta descripción no modifica el stock.</div></div><div class="field-grid"><div class="field"><label for="editMatUnit">Unidad para contar el stock</label><select id="editMatUnit" ${activeRefs?'disabled':''}>${options}</select></div><div class="field"><label for="editMatStock">Cantidad actual</label><input id="editMatStock" inputmode="decimal" value="${esc(String(m.stock))}" ${activeRefs?'disabled':''}></div><div class="field"><label for="editMatMin">Stock mínimo</label><input id="editMatMin" inputmode="decimal" value="${esc(String(m.minStock))}"></div></div>${activeRefs?'<div class="notice warn">Hay fabricaciones activas que utilizan este material. Por seguridad, no se puede cambiar la unidad ni el stock hasta anular o finalizar esas órdenes. Sí podés corregir el nombre, la categoría y la descripción.</div>':'<div class="notice">Ejemplo: nombre «Barra de aluminio», unidad «Piezas», cantidad «5», descripción «50 × 15 mm · largo 5 m».</div>'}`, 'Guardar cambios',()=>{
    const name=clean($('editMatName').value),category=clean($('editMatCategory').value),detail=clean($('editMatDetail').value),unit=$('editMatUnit').value,stock=activeRefs?m.stock:number($('editMatStock').value),min=number($('editMatMin').value);
    if(!name||!category||!Number.isFinite(stock)||stock<0||!Number.isFinite(min)||min<0){alert('Completá nombre y categoría. Las cantidades deben ser números válidos y no negativos.');return false}
    if(!activeRefs&&DISCRETE_UNITS.has(unit)&&(!Number.isInteger(stock)||!Number.isInteger(min))){alert(`La unidad ${unit} requiere cantidades enteras.`);return false}
    if(db.materials.some(other=>other.id!==id&&!other.archived&&norm(other.name)===norm(name)&&norm(other.category)===norm(category)&&norm(other.unit)===norm(unit)&&norm(other.detail)===norm(detail))){alert('Ya existe otro material activo con esos mismos datos.');return false}
    const before={name:m.name,category:m.category,detail:m.detail,unit:m.unit,stock:m.stock,minStock:m.minStock};
    return transact(()=>{m.name=name;m.category=category;m.detail=detail;if(!activeRefs){m.unit=unit;m.stock=Number(stock.toFixed(6))}m.minStock=Number(min.toFixed(6));if(m.stock!==before.stock||m.unit!==before.unit)logMove('Stock corregido desde edición',`${m.name}: ${fmt(before.stock)} ${before.unit} → ${fmt(m.stock)} ${m.unit}`);logMove('Material editado',`${before.name} → ${m.name}; descripción técnica actualizada.`)},'Material actualizado.');
  });
}
function archiveMaterial(id){
  const m=db.materials.find(x=>x.id===id&&!x.archived&&!x.deleted);
  if(!m)return notify('Este material ya no está en el inventario activo.');
  const relatedJobs=db.jobs.filter(j=>(j.lines||[]).some(line=>line.source==='material'&&line.itemId===id)).length;
  const relatedScraps=db.leftovers.filter(l=>l.materialId===id).length;
  const summary=`

