  $('movementRows').innerHTML=db.moves.map(m=>`<tr><td class="selection-cell"><input type="checkbox" data-select-move="${esc(m.id)}" aria-label="Seleccionar movimiento" ${selectedMoveIds.has(m.id)?'checked':''}></td><td>${esc(m.date)}</td><td><span class="badge neutral">${esc(m.type)}</span></td><td>${esc(m.detail)}</td></tr>`).join('')||'<tr><td colspan="4"><div class="empty">Todavía no hay movimientos.</div></td></tr>';
