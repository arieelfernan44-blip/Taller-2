function renderHome(){$('metricMaterials').textContent=activeMaterials().length;$('metricCategories').textContent=new Set(activeLeftovers().map(l=>l.category)).size;$('metricJobs').textContent=db.jobs.filter(j=>j.status==='active').length;const alerts=activeMaterials().filter(m=>m.stock<=0||(m.minStock>0&&m.stock<=m.minStock));$('dashboardAlerts').innerHTML=alerts.map(m=>`<div class="group-material"><span><strong>${esc(m.name)}</strong><span class="secondary-cell">Mínimo: ${fmt(m.minStock)} ${esc(m.unit)}</span></span><span class="badge warn">${fmt(m.stock)} ${esc(m.unit)}</span></div>`).join('')||'<div class="empty">No hay materiales por debajo del mínimo.</div>';$('dashboardRecent').innerHTML=db.moves.slice(0,6).map(m=>`<div class="activity"><span class="activity-dot"></span><div><div class="activity-title">${esc(m.type)}</div><div class="activity-detail">${esc(m.detail)}</div><div class="activity-date">${esc(m.date)}</div></div></div>`).join('')||'<div class="empty">Todavía no hay movimientos registrados.</div>'}
