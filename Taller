}
function selectedJobsInSafeOrder(ids){
  const chosen=new Set(ids),selected=db.jobs.filter(j=>chosen.has(j.id)),active=selected.filter(j=>j.status==='active');
  for(const parent of selected){
    const produced=new Set(jobOutputIds(parent));
    const outside=db.jobs.find(other=>other.status==='active'&&!chosen.has(other.id)&&(other.lines||[]).some(line=>line.source==='leftover'&&produced.has(line.itemId)));
    if(outside)throw new Error(`No se puede borrar «${parent.product}»: un sobrante suyo todavía se utiliza en «${outside.product}». Primero anulá esa fabricación o incluila en la selección.`);
  }
  const order=[],visiting=new Set(),visited=new Set();
  function visit(job){
    if(visited.has(job.id))return;
    if(visiting.has(job.id))throw new Error('Se detectó una dependencia circular entre fabricaciones. No se borró ningún dato.');
    visiting.add(job.id);
    const produced=new Set(jobOutputIds(job));
    for(const child of active){if(child.id!==job.id&&(child.lines||[]).some(line=>line.source==='leftover'&&produced.has(line.itemId)))visit(child)}
    visiting.delete(job.id);visited.add(job.id);order.push(job);
  }
  active.forEach(visit);
  return order;
}
function deleteJobs(ids,description){
  const unique=[...new Set(ids)].filter(id=>db.jobs.some(j=>j.id===id));
  if(!unique.length)return alert('No hay fabricaciones seleccionadas.');
  let order;
  try{order=selectedJobsInSafeOrder(unique)}catch(err){return alert(err.message)}
  const prompt=`Vas a eliminar ${unique.length} fabricación(es) ${description||''}. Las activas devolverán al inventario los materiales utilizados y se quitarán sus sobrantes generados. Esta acción no se puede deshacer. ¿Continuar?`;
  if(!confirm(prompt))return;
  const selectedSet=new Set(unique);const producedIds=new Set([...db.jobs.filter(j=>selectedSet.has(j.id)).flatMap(jobOutputIds),...db.leftovers.filter(l=>selectedSet.has(l.jobId)).map(l=>l.id)]);
  const ok=transact(()=>{
    // Apply reversals inside the transaction so a storage failure restores both history and stock.
    for(const job of order){
      for(const line of job.lines||[]){
        if(line.source==='material'){
          const m=db.materials.find(x=>x.id===line.itemId);
          if(m)m.stock=Number((m.stock+Number(line.totalQty||0)).toFixed(6));
        }else{
          const l=db.leftovers.find(x=>x.id===line.itemId);
          if(l){l.remainingQty=Number((l.remainingQty+Number(line.totalQty||0)).toFixed(6));if(l.remainingQty>0)l.status='active'}
        }
      }
    }
    db.leftovers=db.leftovers.filter(l=>!producedIds.has(l.id));
    db.jobs=db.jobs.filter(j=>!unique.includes(j.id));
    logMove('Fabricaciones eliminadas',`${unique.length} orden(es) eliminadas; los consumos de órdenes activas se devolvieron al stock.`);
  },'Fabricaciones eliminadas y existencias recalculadas.');
  if(ok){unique.forEach(id=>selectedJobIds.delete(id));renderAll()}
}
