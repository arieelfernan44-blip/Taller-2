function renderModels(){$('modelRows').innerHTML=db.models.map(m=>`<div class="data-row"><div class="data-row-head"><span class="row-title">${esc(m.name)}</span><div class="row-actions"><button class="btn btn-primary btn-sm" data-action="use-model" data-id="${esc(m.id)}">Usar</button><button class="btn btn-danger btn-sm" data-action="delete-model" data-id="${esc(m.id)}">Eliminar</button></div></div><div class="small muted">${esc(m.type||'Producto')} ${m.line?'· '+esc(m.line):''}</div><div class="calc-preview">Medidas del producto: ${esc(m.width||'—')} × ${esc(m.height||'—')} cm</div>${m.notes?`<div class="small muted" style="margin-top:7px">${esc(m.notes)}</div>`:''}</div>`).join('')||'<div class="empty">No hay modelos guardados.</div>'}
