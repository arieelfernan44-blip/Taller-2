  const all=db.leftovers.filter(l=>!l.deleted);
  const available=activeLeftovers();
  const rawQuery=clean($('scrapSearch')?.value||'');
  const rawMeasure=clean($('scrapMeasureSearch')?.value||'');
  const queryTokens=scrapSearchTokens(rawQuery);
  const measureTokens=scrapSearchTokens(rawMeasure);
  const searchable=l=>normalizeScrapSearch([l.category,l.materialName,l.description,l.origin].join(' '));
  const measureSearchable=l=>normalizeScrapSearch(l.description||'');
  const catsByKey=new Map();
  all.forEach(l=>{const key=norm(l.category)||'sin-categoria';if(!catsByKey.has(key))catsByKey.set(key,clean(l.category)||'Sin categoría')});
  const cats=[...catsByKey.values()].sort((a,b)=>a.localeCompare(b,'es'));
  $('scrapSummary').innerHTML=cats.length?cats.map(c=>{const total=all.filter(l=>norm(l.category||'Sin categoría')===norm(c||'Sin categoría')).length;const ready=available.filter(l=>norm(l.category||'Sin categoría')===norm(c||'Sin categoría')).length;return `<div class="group-material"><strong>${esc(c)}</strong><span class="badge">${ready} disponible(s) · ${total} registro(s)</span></div>`}).join(''):'<div class="empty">Todavía no hay sobrantes registrados.</div>';
  // Every term in the main box must match somewhere in the record, allowing category + dimensions together.
  // The dedicated measure box is an additional AND filter against the measure/description field.
  const filtered=all.filter(l=>{
    const full=searchable(l),measure=measureSearchable(l);
    return queryTokens.every(token=>full.includes(token))&&measureTokens.every(token=>measure.includes(token));
  });
  const groups=new Map();
  filtered.forEach(l=>{const key=norm(l.category)||'sin-categoria';if(!groups.has(key))groups.set(key,{label:clean(l.category)||'Sin categoría',items:[]});groups.get(key).items.push(l)});
  const queryLabel=[rawQuery,rawMeasure?`medida: ${rawMeasure}`:''].filter(Boolean).join(' · ');
  $('scrapSearchMeta').textContent=queryLabel?`${filtered.length} sobrante(s) encontrado(s) para «${queryLabel}» · ${groups.size} categoría(s)`:`${all.length} registro(s) en ${cats.length} categoría(s) · ${available.length} disponible(s)`;
  $('scrapGroups').innerHTML=[...groups.values()].sort((a,b)=>a.label.localeCompare(b.label,'es')).map(group=>`<div class="group-card"><div class="group-head"><strong>${esc(group.label)}</strong><span class="badge">${group.items.length} registro(s)</span></div><div class="group-body">${group.items.map(l=>{const isAvailable=l.status==='active'&&Number(l.remainingQty)>0;return `<div class="group-material"><span class="scrap-item-main"><strong>${esc(l.materialName)}</strong><span class="secondary-cell">${esc(l.origin||'Registro manual')}</span><span class="badge ${isAvailable?'':'neutral'}">${isAvailable?'Disponible':'Sin disponibilidad'}</span></span><div class="row-actions"><button class="btn btn-ghost btn-sm scrap-view-btn" data-action="view-scrap" data-id="${esc(l.id)}">Ver características</button><button class="btn btn-danger btn-sm" data-action="delete-scrap" data-id="${esc(l.id)}">Eliminar</button></div></div>`}).join('')}</div></div>`).join('')||((queryTokens.length||measureTokens.length)?`<div class="empty"><strong>No se encontraron sobrantes</strong>Probá con otra categoría o medida. Podés escribir, por ejemplo, «vidrio 50 x 30».</div>`:'<div class="empty">No hay sobrantes registrados.</div>');
  refreshScrapCategories();
}
